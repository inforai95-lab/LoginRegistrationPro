```cshtml
@model LoginRegistrationApp.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="container mt-4">
    <div class="card border-danger" style="max-width: 600px;">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Confirm Employee Deletion</h4>
        </div>

        <div class="card-body">
            <p>Are you sure you want to delete this employee?</p>

            <dl class="row">
                <dt class="col-sm-4">Employee ID</dt>
                <dd class="col-sm-8">@Model.EmployeeId</dd>

                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.EmployeeName</dd>

                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Department</dt>
                <dd class="col-sm-8">@Model.Department</dd>
            </dl>

            <form asp-action="Delete"
                  asp-route-id="@Model.EmployeeId"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    Yes, Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
```