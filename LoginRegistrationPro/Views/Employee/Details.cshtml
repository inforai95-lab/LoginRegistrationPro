
@model LoginRegistrationApp.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container mt-4">
    <div class="card shadow-sm" style="max-width: 650px;">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Employee Details</h4>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Employee ID</dt>
                <dd class="col-sm-8">@Model.EmployeeId</dd>

                <dt class="col-sm-4">Employee Name</dt>
                <dd class="col-sm-8">@Model.EmployeeName</dd>

                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Department</dt>
                <dd class="col-sm-8">@Model.Department</dd>

                <dt class="col-sm-4">Salary</dt>
                <dd class="col-sm-8">@Model.Salary.ToString("N2")</dd>
            </dl>

            <a asp-action="Edit"
               asp-route-id="@Model.EmployeeId"
               class="btn btn-warning">
                Edit
            </a>

            <a asp-action="Index" class="btn btn-secondary">
                Back to List
            </a>
        </div>
    </div>
</div>
